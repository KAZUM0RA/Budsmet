# systemd-юніт застосунку Budsmet.
# Встановлюється скриптом setup.sh у /etc/systemd/system/budsmet.service
[Unit]
Description=Budsmet — веб-застосунок для складання будівельних кошторисів
Documentation=https://github.com/KAZUM0RA/Budsmet
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=__USER__
Group=__USER__
WorkingDirectory=__APP_DIR__
Environment=PYTHONUNBUFFERED=1
Environment=BUDSMET_DB=__DATA_DIR__/budsmet.db
# Ключі до пошукових сервісів для аналізу цін в інтернеті (необов'язково).
EnvironmentFile=-/etc/budsmet.env
ExecStart=__VENV_DIR__/bin/uvicorn backend.main:app --host 127.0.0.1 --port __PORT__ --workers 1
Restart=always
RestartSec=3

# Обмеження прав: застосунок пише лише у свій каталог даних.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=__DATA_DIR__

[Install]
WantedBy=multi-user.target
